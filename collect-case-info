    if args.json:
        output_content = json.dumps(data, indent=2)
    else:
        output_content = generate_case_markdown(data)

    # Output handling
    if show_banner:
        print("\n" + "=" * 60)
        print("                     Generated Support Case")
        print("=" * 60 + "\n")
    print(output_content)

    # Save to file if requested or if output flag is set
    out_file = args.output
    if out_file:
        with open(out_file, "w", encoding="utf-8") as f:
            f.write(output_content)
        if not args.quiet:
            print(f"\n✓ Saved support case to: {out_file}")

    # Copy to clipboard if requested
    if args.clipboard:
        copied, tool = copy_to_clipboard(output_content)
        if not args.quiet:
            if copied:
                print(f"✓ Copied support case to clipboard (using {tool})")
            else:
                print("! Could not copy to clipboard (no supported clipboard utility found)")

    # Compile to PDF if requested
    if args.pdf:
        pdf_md_file = out_file
        cleanup_temp_md = False
        if not pdf_md_file:
            tf = tempfile.NamedTemporaryFile(suffix=".md", mode="w", delete=False)
            tf.write(output_content)
            tf.close()
            pdf_md_file = tf.name
            cleanup_temp_md = True

        pdf_out = os.path.splitext(pdf_md_file)[0] + ".pdf" if not cleanup_temp_md else f"case-{int(time.time())}.pdf"

        # Look for md2pdf
        md2pdf_cmd = None
        if shutil.which("md2pdf"):
            md2pdf_cmd = "md2pdf"
        else:
            local_md2pdf = os.path.join(os.path.dirname(os.path.abspath(__file__)), "md2pdf")
            if os.path.exists(local_md2pdf) and os.access(local_md2pdf, os.X_OK):
                md2pdf_cmd = local_md2pdf

        if md2pdf_cmd:
            if not args.quiet:
                print(f"Compiling PDF via {md2pdf_cmd} --theme {args.theme}...")
            res = subprocess.run([md2pdf_cmd, pdf_md_file, pdf_out, "--theme", args.theme])
            if not args.quiet:
                if res.returncode == 0:
                    print(f"✓ Generated PDF: {pdf_out}")
                else:
                    print("! Failed to compile PDF with md2pdf.")
        else:
            if not args.quiet:
                print("! md2pdf command not found in PATH or script directory. Skipping PDF generation.")

        if cleanup_temp_md and os.path.exists(pdf_md_file):
            os.remove(pdf_md_file)


